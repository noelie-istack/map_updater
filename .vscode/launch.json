{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "map_updater (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-browser-flag",
        "--disable-web-security"
      ]
    },
    {
      "name": "map_updater (Web Server)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": ["-d", "web-server", "--web-port", "8080"]
    }
  ]
}
